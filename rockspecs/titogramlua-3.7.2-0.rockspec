        ["titogramlua.methods.userbot.get_chat_photos_count"] = "src/methods/userbot/get_chat_photos_count.lua",
        ["titogramlua.methods.userbot.get_chat_stories"] = "src/methods/userbot/get_chat_stories.lua",
