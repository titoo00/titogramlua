        ["titogramlua.methods.userbot.get_default_emoji_statuses"] = "src/methods/userbot/get_default_emoji_statuses.lua",
        ["titogramlua.methods.userbot.get_global_privacy_settings"] = "src/methods/userbot/get_global_privacy_settings.lua",
        ["titogramlua.methods.userbot.get_me"] = "src/methods/userbot/get_me.lua",
