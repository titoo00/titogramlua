        ["titogramlua.methods.userbot.send_photo"] = "src/methods/userbot/send_photo.lua",
        ["titogramlua.methods.userbot.send_story"] = "src/methods/userbot/send_story.lua",
        ["titogramlua.methods.userbot.set_account_ttl"] = "src/methods/userbot/set_account_ttl.lua",
        ["titogramlua.methods.userbot.set_emoji_status"] = "src/methods/userbot/set_emoji_status.lua",
        ["titogramlua.methods.userbot.set_global_privacy_settings"] = "src/methods/userbot/set_global_privacy_settings.lua",
        ["titogramlua.methods.userbot.set_inactive_session_ttl"] = "src/methods/userbot/set_inactive_session_ttl.lua",
